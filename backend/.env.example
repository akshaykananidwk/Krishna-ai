# ============================================================
# Krishna AI — Backend environment configuration (example)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---- Application ----
PROJECT_NAME=Krishna AI
ENVIRONMENT=development           # development | staging | production
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- Security / JWT ----
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-please-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ---- Field-level encryption (AES-256) ----
# Generate with: openssl rand -hex 32   (32 bytes -> 64 hex chars)
ENCRYPTION_KEY=change-me-64-hex-chars-for-aes-256-field-encryption-here-000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=krishna
POSTGRES_PASSWORD=krishna_dev_password
POSTGRES_DB=krishna_ai

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Qdrant (vector DB) ----
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Firebase (server-side verification of client ID tokens) ----
# Path to service-account json OR leave blank in dev to disable.
FIREBASE_CREDENTIALS_PATH=

# ---- AI / Anthropic (Module: AI Chat) ----
# Create a key at https://console.anthropic.com/ . Leave blank to disable AI chat.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
AI_MAX_TOKENS=4096
AI_HISTORY_LIMIT=40

# ---- Memory Engine (Module 4: Memory + Vector Search + RAG) ----
# Embeddings: local (default, no deps) | openai | gemini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
LOCAL_EMBEDDING_DIM=256
# Vector store: memory (default, dev/test) | qdrant
VECTOR_STORE=memory
QDRANT_COLLECTION=krishna_memory
RAG_TOP_K=8
RAG_MIN_SCORE=0.15
RAG_MAX_CONTEXT_CHARS=6000
MEMORY_DUPLICATE_THRESHOLD=0.92
MEMORY_RETENTION_DAYS=30
